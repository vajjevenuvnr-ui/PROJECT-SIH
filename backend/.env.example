# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Postgres connection string, used by scripts (seed, pipeline). Supabase > Project Settings > Database > URI
DATABASE_URL=
# true = serve cached JSON from data/demo/ (works offline)
DEMO_MODE=false
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Web Push for farmer alerts: run `python -m scripts.gen_vapid` to fill these in
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Run the downscaling pipeline daily at 06:00 IST inside the API (true/false)
PIPELINE_SCHEDULE=false
PIPELINE_PUBLISH_DEMO=false
